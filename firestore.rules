rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 익명 닉네임과 연결된 독서 기록 컬렉션 (reading_logs)
    // 인사(greetings)나 불필요한 부가 데이터는 저장하지 않고,
    // 특정 닉네임(nickname)과 그에 따른 독서기록(책제목, 시간, 한문장, 완독여부 등)만 저장합니다.
    match /reading_logs/{logId} {
      allow read: if true;

      allow create, update: if (
        request.resource.data.keys().hasAll([
          'nickname',
          'bookTitle',
          'status',
          'totalSeconds',
          'quote',
          'createdAt',
          'createdAtMs'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id',
          'nickname',
          'bookTitle',
          'status',
          'totalSeconds',
          'quote',
          'memo',
          'progressNote',
          'mapName',
          'createdAt',
          'createdAtMs'
        ]) &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() > 0 &&
        request.resource.data.nickname.size() <= 30 &&
        request.resource.data.bookTitle is string &&
        request.resource.data.bookTitle.size() > 0 &&
        request.resource.data.bookTitle.size() <= 100 &&
        request.resource.data.status in ['completed', 'reading'] &&
        request.resource.data.totalSeconds is number &&
        request.resource.data.totalSeconds >= 0 &&
        request.resource.data.quote is string &&
        request.resource.data.quote.size() > 0 &&
        request.resource.data.quote.size() <= 300
      );

      allow delete: if false;
    }
  }
}
