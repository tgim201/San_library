rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 공유된 독서 기록 서가 컬렉션 (reading_logs)
    match /reading_logs/{logId} {
      allow read: if true;

      allow create, update: if (
        request.resource.data.keys().hasAll(['bookTitle', 'status', 'totalSeconds', 'quote', 'nickname', 'createdAt']) &&
        request.resource.data.bookTitle is string &&
        request.resource.data.bookTitle.size() > 0 &&
        request.resource.data.bookTitle.size() <= 100 &&
        request.resource.data.status in ['completed', 'reading'] &&
        request.resource.data.totalSeconds is number &&
        request.resource.data.quote is string &&
        request.resource.data.quote.size() > 0 &&
        request.resource.data.quote.size() <= 300
      );

      allow delete: if false;
    }

    // 실시간 가벼운 인사 알림 컬렉션 (greetings)
    match /greetings/{greetingId} {
      allow read: if true;
      allow create: if (
        request.resource.data.keys().hasAll(['nickname', 'createdAtMs']) &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() > 0 &&
        request.resource.data.nickname.size() <= 30
      );
      allow update, delete: if false;
    }
  }
}
